# Free-tier Google AI Studio API key (do NOT commit real keys)
GEMINI_API_KEY=your_free_tier_gemini_api_key_here

# Active Gemini free-tier model ID (check Google AI Studio for exact ID)
LLM_MODEL=gemini-3.5-flash-lite

# Optional comma-separated host allowlist (e.g. webdriveruniversity.com,127.0.0.1,localhost)
# Leave empty to allow any valid http/https target during Phase 1 testing
ALLOWED_HOSTS=webdriveruniversity.com,www.webdriveruniversity.com

# Isolated browser runner guardrails
RUNNER_TIMEOUT_SEC=60
BROWSER_SLOWMO_MS=0
BROWSER_HOLD_MS=1200
